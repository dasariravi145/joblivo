# =============================================================================
# Joblivo API - Local Environment Template
# =============================================================================
# Copy this file to .env or .env.local for local overrides.
# Do NOT commit secrets or production credentials to source control.

SERVER_PORT=8080
SPRING_APPLICATION_NAME=joblivo-api
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/joblivo_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# AI Gateway Configuration (Foundation)
JOBLIVO_AI_ENABLED=false
JOBLIVO_AI_DEFAULT_PROVIDER=BEDROCK
JOBLIVO_AI_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
JOBLIVO_AI_BEDROCK_ENABLED=false
JOBLIVO_AI_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
JOBLIVO_AI_BEDROCK_REGION=
JOBLIVO_AI_BEDROCK_TIMEOUT_SECONDS=30
JOBLIVO_AI_OPENAI_ENABLED=false
JOBLIVO_AI_GOOGLE_ENABLED=false

